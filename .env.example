API_URL=<API_URL>
API_KEY=<API_KEY>
MODEL=<MODEL>
# ocr = read the text with Tesseract first; image = send the screenshot itself (the model must accept images)
MODE=ocr
# seconds between pings that keep the API connection open (saves ~0.5s after idle); 0 = off
KEEP_WARM=60
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
